# Ambiente Python do Sistema de Estudos (pesado — não versionar)
Pessoal/_Sistema-Estudos/.venv/
**/__pycache__/
*.pyc

# Áudio temporário das gravações
Pessoal/_Sistema-Estudos/_audio/

# Pasta que não deve ir para o repositório
Pessoal/Reative Systems/

# Dado pessoal — NUNCA versionar. O repositório é público, e o job de backup
# horário commita o vault inteiro sem ninguém olhar o que entrou.
# Currículo e certificado carregam nome completo, e-mail, telefone e LinkedIn.
Pessoal/Curriculos/
Pessoal/Certificados/

# Transcrições brutas pré-processamento
*.bak

# Comandos do Claude Code — ferramenta local, não é conteúdo do vault
.claude/

# Planos pessoais (metas, renda, carreira): ficam só na máquina
Pessoal/Planos/

# Rascunhos de post do blog: a versão pública sai pelo repo do blog, revisada
Pessoal/Blog/

# PDFs de livros de terceiros: direito autoral, não vão para repo público
Pessoal/Livros/**/*.pdf

# Laboratório de Dados: fica só na máquina
Pessoal/Laboratório de Dados/

# Lista de arquivos abertos do Obsidian: expõe nomes das pastas ignoradas acima
.obsidian/workspace.json
